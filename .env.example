# =====================================================================
# PapaSana AP-01 — variables de entorno
# Copie este archivo a .env (scripts/init.ps1 lo hace y genera secretos).
# NUNCA suba .env al repositorio.
# =====================================================================

# --- General ---------------------------------------------------------
APP_NAME="PapaSana AP-01"
APP_ENV=development
TZ_DISPLAY=America/Lima
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- PostgreSQL ------------------------------------------------------
POSTGRES_DB=papasana
POSTGRES_TEST_DB=papasana_test
# Usuario propietario: solo para migraciones y datos semilla
POSTGRES_USER=papasana_owner
POSTGRES_PASSWORD=
# Usuario de la aplicación: privilegios mínimos (sin UPDATE/DELETE en la bitácora)
APP_DB_USER=papasana_app
APP_DB_PASSWORD=

# --- Seguridad -------------------------------------------------------
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
# Contraseña de los usuarios demo (solo APP_ENV=development)
DEMO_USERS_PASSWORD=

# --- Redis -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- MinIO -----------------------------------------------------------
MINIO_ROOT_USER=papasana
MINIO_ROOT_PASSWORD=

# --- Correo (Mailpit en desarrollo: http://localhost:8025) -----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-responder@papasana.pe

# --- Servicio de inferencia (token interno backend → ml-service) ----
ML_SERVICE_TOKEN=

# --- MLflow (Fase 4): base `mlflow` en PostgreSQL con rol propio ----
MLFLOW_DB_PASSWORD=
# URL de MLflow que muestra la interfaz (el servidor publica el puerto solo en 127.0.0.1)
MLFLOW_UI_URL=http://127.0.0.1:5000

# --- LLM (Fase 6) ----------------------------------------------------
# Nivel gratuito de Gemini: solo datos demo (ver docs/decisiones.md D-20)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
